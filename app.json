{
  "expo": {
    "name": "Lift Log",
    "slug": "lift-log",
    "scheme": "liftlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.erpkenya.liftlog",
      "adaptiveIcon": {
        "backgroundColor": "#2350A8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2350A8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Lift Log uses the camera to photograph meals for calorie estimates.",
          "photosPermission": "Lift Log reads a meal photo you pick for calorie estimates.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2350A8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
